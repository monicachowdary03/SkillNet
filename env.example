# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/skillnet

# ── Session secret ────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_long_random_string

# ── Email / OTP  (pick one setup below) ──────────────────────────────────────

# Option A – Real SMTP (Gmail example)
#   For Gmail: enable 2FA → Google Account → App Passwords → generate one
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@gmail.com
MAIL_PASS=your_16char_app_password

# Option B – Ethereal (free fake inbox, great for development)
#   Set this to true; no other MAIL_* vars needed.
#   The preview URL is printed in the server console after each login attempt.
USE_ETHEREAL=true
